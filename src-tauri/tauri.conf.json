{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gameyfin",
  "identifier": "org.gameyfin.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Gameyfin",
        "width": 1280,
        "height": 800,
        "minWidth": 940,
        "minHeight": 600,
        "resizable": true,
        "decorations": false,
        "center": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: gfimg: http://gfimg.localhost; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost; frame-src https://www.youtube-nocookie.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm",
      "appimage",
      "msi",
      "nsis"
    ],
    "externalBin": [
      "binaries/ludusavi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Game",
    "shortDescription": "Gameyfin desktop client",
    "longDescription": "Download, install, play and sync saves for games from your Gameyfin server.",
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0"
        ],
        "recommends": [
          "unar"
        ]
      },
      "rpm": {
        "recommends": [
          "unar"
        ]
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/gameyfin/gameyfin-app/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZDMzE5MEQ4N0M2NjYyRTkKUldUcFltWjgySkF4L0NGc1Q5OEVnbDdwUEtQYW90QlhxREl",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
