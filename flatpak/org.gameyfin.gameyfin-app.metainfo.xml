<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>org.gameyfin.gameyfin-app</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>

  <name>gameyfin-app</name>
  <summary>Play your Gameyfin library</summary>
  <developer id="io.github.wieluk">
    <name>wieluk</name>
  </developer>

  <description>
    <p>
      A client for a Gameyfin server. Browse your library, download and install games,
      play them, and keep your saves in sync between PCs.
    </p>
    <ul>
      <li>Library with search, filters, cover sizes, photos and trailers, usable offline</li>
      <li>Downloads with a speed limit, several games folders and optional auto install</li>
      <li>Unpacks archives, runs setup programs and uninstalls cleanly</li>
      <li>Windows games through Proton and umu, with DXVK, vkd3d-proton and per-game options</li>
      <li>Save sync to the Gameyfin server, a folder or WebDAV, with version history</li>
      <li>Shortcuts, controller navigation, tray icon and automatic updates</li>
    </ul>
  </description>

  <launchable type="desktop-id">org.gameyfin.gameyfin-app.desktop</launchable>

  <url type="homepage">https://github.com/wieluk/gameyfin-app</url>
  <url type="bugtracker">https://github.com/wieluk/gameyfin-app/issues</url>
  <url type="help">https://github.com/wieluk/gameyfin-app/tree/main/docs</url>
  <url type="vcs-browser">https://github.com/wieluk/gameyfin-app</url>

