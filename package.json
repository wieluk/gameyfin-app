{
  "name": "gameyfin-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "set-version": "node scripts/set-version.mjs",
    "test": "vitest run",
    "lint:docs": "markdownlint-cli2 --config package.json --configPointer /markdownlint-cli2 && cspell --no-progress",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "tauri": "tauri",
    "fetch-sidecars": "node scripts/fetch-sidecar.mjs",
    "package": "node scripts/package.mjs",
    "package:flatpak": "node scripts/build-flatpak.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "verify": "npm run typecheck && npm test && npm run lint:docs && cargo clippy --workspace --all-targets -- -D warnings && cargo test --workspace",
    "package:flatpak:install": "node scripts/build-flatpak.mjs --install"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.105.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@cspell/dict-en-gb": "^5.0.38",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/cli": "^2.12.4",
    "@tauri-apps/plugin-clipboard-manager": "^2.5.0",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "cspell": "^10.4.0",
    "jsdom": "^30.1.3",
    "markdownlint-cli2": "^0.24.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitepress": "^1.6.4",
    "vitest": "^5.0.5"
  },
  "markdownlint-cli2": {
    "config": {
      "MD013": {
        "line_length": 100,
        "tables": false,
        "code_blocks": false,
        "headings": false
      }
    },
    "globs": [
      "*.md",
      "docs/**/*.md"
    ],
    "gitignore": true
  },
  "cspell": {
    "version": "0.2",
    "language": "en-GB",
    "import": [
      "@cspell/dict-en-gb/cspell-ext.json"
    ],
    "files": [
      "*.md",
      "docs/**/*.md"
    ],
    "ignoreRegExpList": [
      "/`[^`\\n]*`/g"
    ],
    "words": [
      "Authelia",
      "CachyOS",
      "clippy",
      "dialog",
      "DXVK",
      "Flathub",
      "Gameyfin",
      "Inno",
      "Ludusavi",
      "Nextcloud",
      "NSIS",
      "redistributables",
      "rustup",
      "Syncthing",
      "Winetricks"
    ],
    "useGitignore": true
  }
}
